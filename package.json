{
  "name": "elementpay-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.strict.json",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "api:spec": "node scripts/fetch-openapi.mjs",
    "api:gen": "openapi-typescript lib/api/openapi.json -o lib/api/generated/mboka.ts",
    "api:check": "npm run api:gen && git diff --exit-code -- lib/api/generated",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "check": "npm run tokens:check && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.8.0",
    "@stellar/stellar-sdk": "^16.4.1",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "jspdf": "^4.2.1",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.7.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-mcp": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-storybook": "10.6.5",
    "jsdom": "^30.0.1",
    "openapi-typescript": "7.13.0",
    "storybook": "10.6.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.72.1",
    "vitest": "^4.1.12"
  }
}
