{
  "$description": "Mboka brand + UI design tokens — the ONE source of truth. W3C Design Tokens (DTCG 2025.10) format ($type / $value / $description, {alias} references); colour values are CSS strings for readability. Values marked PROPOSED were filled in by the original designer when formalising the system (no prior design); everything else is DECIDED. Edit this file, then run `npm run tokens` to regenerate lib/theme/tokens.generated.ts and app/tokens.generated.css. Never edit the generated files.",

  "color": {
    "$type": "color",
    "brand": {
      "$description": "Fixed brand palette (theme-independent). Marks, illustrations, card colours, marketing accents — not UI surfaces/text, which use theme tokens. Accent fills (marigold, mint, coral, lavender) are never text on light.",
      "indigo": { "$value": "#3B2ED3", "$description": "Primary on light: CTAs, links, focus, selected, settled/paid." },
      "indigo-lift": { "$value": "#7C6FFF", "$description": "Primary on dark; card colour \"Indigo Lift\"." },
      "ink": { "$value": "#131126", "$description": "Text on light; ink panels." },
      "bone": { "$value": "#F6F4EF", "$description": "Canvas on light. Never pure white canvas." },
      "white": { "$value": "#FFFFFF", "$description": "Panels and inputs only, never the canvas." },
      "marigold": { "$value": "#FFB224", "$description": "Accent fill. Never text on light." },
      "mint": { "$value": "#5ED6B4", "$description": "Accent fill." },
      "coral": { "$value": "#FF6A55", "$description": "Accent fill." },
      "lavender": { "$value": "#9590E6", "$description": "Accent fill." },
      "cobalt": { "$value": "#2457E6", "$description": "Card colour." },
      "orchid": { "$value": "#A94BD9", "$description": "Card colour." },
      "sky": { "$value": "#63B3FF", "$description": "Card colour." },
      "plum": { "$value": "#4A1D6E", "$description": "Card colour." },
      "positive": { "$value": "#0E7A5A", "$description": "Incoming-money amounts on light. Not a status colour." },
      "amber": { "$value": "{color.brand.marigold}", "$description": "DEPRECATED alias of marigold (landing code). Use marigold." },
      "violet": { "$value": "#7C6FFF", "$description": "DEPRECATED (= indigo-lift). Landing art only; not in the brand palette." },
      "positive-on-dark": { "$value": "#0E9A70", "$description": "Landing only. Dashboard dark theme uses theme.dark.positive." }
    },
    "feedback": {
      "$description": "Fixed light-canvas feedback colours used by auth pages (outside the theme toggle). Not part of the designer spec — kept as shipped.",
      "muted-soft": { "$value": "#6B6980", "$description": "Soft secondary text, ≥4.5:1 on bone." },
      "error-text": { "$value": "#C81E24" },
      "error-field-bg": { "$value": "#FFF8F8" },
      "error-field-border": { "$value": "rgba(229,72,77,0.55)" },
      "error-banner-border": { "$value": "rgba(229,72,77,0.18)" },
      "success-bg": { "$value": "#E8F7EE" },
      "success-text": { "$value": "#1B7A3D" },
      "success-border": { "$value": "rgba(27,122,61,0.16)" }
    }
  },

  "chart": {
    "$type": "color",
    "$description": "PROPOSED data-viz palette (fixed, theme-independent). Categorical = brand accents in this order; sequential = indigo ramp. Utilities: bg-chart-1 … bg-chart-8, bg-chart-seq-1 … 6, text-chart-positive/negative/neutral.",
    "categorical": {
      "1": { "$value": "{color.brand.indigo}" },
      "2": { "$value": "{color.brand.marigold}" },
      "3": { "$value": "{color.brand.mint}" },
      "4": { "$value": "{color.brand.coral}" },
      "5": { "$value": "{color.brand.lavender}" },
      "6": { "$value": "{color.brand.cobalt}" },
      "7": { "$value": "{color.brand.orchid}" },
      "8": { "$value": "{color.brand.sky}" }
    },
    "sequential": {
      "1": { "$value": "#EEEDFB" },
      "2": { "$value": "#C9C4F4" },
      "3": { "$value": "#9590E6" },
      "4": { "$value": "#6457E0" },
      "5": { "$value": "#3B2ED3" },
      "6": { "$value": "#231A8C" }
    },
    "positive": { "$value": "#0E7A5A" },
    "negative": { "$value": "#C42A2F" },
    "neutral": { "$value": "#8B89A6" }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Space Grotesk", "system-ui", "sans-serif"], "$description": "Headings, navigation chrome, buttons. (Designer name: heading.)" },
      "body": { "$value": ["DM Sans", "system-ui", "sans-serif"], "$description": "Body copy and form text." },
      "mono": { "$value": ["DM Mono", "ui-monospace", "SFMono-Regular", "monospace"], "$description": "Every amount, balance, account number, hash." }
    },
    "size": {
      "$type": "dimension",
      "$description": "Type scale, named by role (the designer's scale; legacy code uses these sizes). Pick the role, not the size — no ad-hoc sizes.",
      "overline-sm": { "$value": "10.5px", "$description": "Small overline." },
      "label": { "$value": "11px", "$description": "Uppercase labels, status chips." },
      "caption": { "$value": "11.5px", "$description": "Captions, helper text." },
      "dense": { "$value": "12px", "$description": "Dense body (chips, compact rows)." },
      "body": { "$value": "12.5px", "$description": "Body, table cells, pill buttons." },
      "body-lg": { "$value": "13px", "$description": "Large body, CTAs." },
      "lead": { "$value": "14px", "$description": "Lead body, descriptions." },
      "title": { "$value": "16px", "$description": "Card and modal titles. Also mobile input text (16px stops iOS zoom)." },
      "headline": { "$value": "19px", "$description": "Sheet headline." },
      "page-sm": { "$value": "20px", "$description": "Page title, mobile." },
      "stat": { "$value": "22px", "$description": "Stat tile value." },
      "amount": { "$value": "24px", "$description": "Amount input." },
      "page": { "$value": "26px", "$description": "Page title, desktop." },
      "hero": { "$value": "32px", "$description": "Hero amount / balance." }
    }
  },

  "line-height": {
    "$type": "number",
    "$description": "Utilities: leading-tight … leading-relaxed (Tailwind defaults removed).",
    "tight": { "$value": 1.05, "$description": "Display / hero amounts." },
    "heading": { "$value": 1.2 },
    "snug": { "$value": 1.35 },
    "body": { "$value": 1.55 },
    "relaxed": { "$value": 1.6 }
  },

  "letter-spacing": {
    "$type": "dimension",
    "$description": "Utilities: tracking-display … tracking-overline (Tailwind defaults removed).",
    "display": { "$value": "-0.04em", "$description": "Hero amounts, display type." },
    "heading": { "$value": "-0.02em", "$description": "Page titles." },
    "title": { "$value": "-0.01em", "$description": "Card / modal titles." },
    "normal": { "$value": "0em" },
    "label": { "$value": "0.06em", "$description": "Uppercase labels." },
    "overline": { "$value": "0.12em", "$description": "Document overlines." }
  },

  "space": {
    "$type": "dimension",
    "$description": "Spacing steps. Tailwind's 4px spacing unit already produces these: 1=4 1.5=6 2=8 2.5=10 3=12 3.5=14 4=16 5=20 6=24 8=32. Use only these steps for padding/gaps.",
    "4": { "$value": "4px" },
    "6": { "$value": "6px" },
    "8": { "$value": "8px" },
    "10": { "$value": "10px" },
    "12": { "$value": "12px" },
    "14": { "$value": "14px" },
    "16": { "$value": "16px" },
    "20": { "$value": "20px" },
    "24": { "$value": "24px" },
    "32": { "$value": "32px" }
  },

  "radius": {
    "$type": "dimension",
    "xs": { "$value": "6px", "$description": "Status chips." },
    "sm": { "$value": "8px", "$description": "Small tiles, menu items." },
    "md": { "$value": "12px", "$description": "Inputs, alerts." },
    "lg": { "$value": "14px", "$description": "CTAs, option cards." },
    "xl": { "$value": "16px", "$description": "Inner cards, stat tiles." },
    "2xl": { "$value": "22px", "$description": "Panels (.ep-panel)." },
    "3xl": { "$value": "28px", "$description": "Modals, sheets, landing cards." },
    "pill": { "$value": "999px", "$description": "Pills, pill buttons, avatars." }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "Borders over shadows: panels have none. Colours written {theme.<t>.<key>} become var(--key) so the shadow follows the active theme.",
    "hairline": { "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px", "color": "rgba(0,0,0,0.08)" }, "$description": "Flags, logos." },
    "float": { "$value": { "offsetX": "0px", "offsetY": "14px", "blur": "30px", "spread": "-16px", "color": "rgba(19,17,38,0.4)" }, "$description": "Menus, popovers." },
    "card": { "$value": { "offsetX": "0px", "offsetY": "26px", "blur": "46px", "spread": "-24px", "color": "rgba(10,8,40,0.55)" }, "$description": "Virtual (payment) cards." },
    "modal": { "$value": { "offsetX": "0px", "offsetY": "34px", "blur": "90px", "spread": "-22px", "color": "rgba(19,17,38,0.5)" }, "$description": "Dialogs and sheets." },
    "selection": {
      "$value": [
        { "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "3px", "color": "{theme.light.panel}" },
        { "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "5px", "color": "{theme.light.indigo-tint}" }
      ],
      "$description": "Selected swatch."
    },
    "focus": {
      "$value": [
        { "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "2px", "color": "{theme.light.bg}" },
        { "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "4px", "color": "{theme.light.focus-ring}" }
      ],
      "$description": "PROPOSED. Keyboard focus (focus-visible)."
    },
    "nav-active": { "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "18px", "spread": "-8px", "color": "rgba(59,46,211,0.5)" }, "$description": "Active sidebar item." },
    "auth": { "$value": "0 12px 40px rgba(19,17,38,0.06)", "$description": "Floating auth cards. As shipped — not in the designer spec." }
  },

  "duration": {
    "$type": "duration",
    "$description": "CSS vars --duration-<name>. In Tailwind use the matching number (duration-150, duration-200…).",
    "instant": { "$value": "150ms", "$description": "Press feedback." },
    "fast": { "$value": "160ms", "$description": "Toggle knob." },
    "base": { "$value": "200ms", "$description": "Sidebar drawer, hovers." },
    "spring": { "$value": "250ms", "$description": "Pop-ins (250–300)." },
    "sheet": { "$value": "280ms", "$description": "Mobile sheet enter." },
    "theme": { "$value": "350ms", "$description": "Theme colour swap." },
    "enter": { "$value": "600ms", "$description": "Landing scene enter." },
    "countdown": { "$value": "1000ms", "$description": "Quote bar tick, linear." }
  },

  "easing": {
    "$type": "cubicBezier",
    "$description": "Utilities: ease-standard, ease-spring, ease-move, ease-linear, ease-sheet (Tailwind defaults removed). Respect prefers-reduced-motion.",
    "standard": { "$value": [0.2, 0.8, 0.2, 1] },
    "spring": { "$value": [0.2, 0.9, 0.3, 1.2], "$description": "Overshoot — pop-ins only." },
    "move": { "$value": [0.4, 0.2, 0.2, 1] },
    "linear": { "$value": [0, 0, 1, 1] },
    "sheet": { "$value": [0.32, 0.72, 0, 1], "$description": "Mobile sheet enter." }
  },

  "breakpoint": {
    "$type": "dimension",
    "desktop": { "$value": "900px", "$description": "Below: drawer sidebar, bottom nav, full-screen sheets. Tailwind variant `desktop:` (the only breakpoint — sm:/md:/lg: are removed). Designer name: mobile." },
    "table-min": { "$value": "820px", "$description": "Tables scroll horizontally below this. Utility: min-w-table." },
    "content-max": { "$value": "1200px", "$description": "Landing sections. Utility: max-w-content." }
  },

  "theme": {
    "$description": "Semantic UI colours per theme. Keys become CSS variables (`bg` → `--bg`) and keep the legacy names that .ep-* CSS and inline styles read; the `tailwind.color` map below gives them their designer/shadcn names (danger → destructive, text-muted-2 → subtle-foreground…). DashboardApp/Landing apply the active set onto <html> via lib/theme/applyThemeVars.",
    "light": {
      "$type": "color",
      "bg": { "$value": "{color.brand.bone}" },
      "surface": { "$value": "rgba(255,255,255,0.55)", "$description": "Glass: sidebar, header, bottom nav." },
      "surface2": { "$value": "rgba(19,17,38,0.045)", "$description": "Inset fills, secondary buttons." },
      "surface3": { "$value": "rgba(19,17,38,0.09)", "$description": "Tracks, draft chip." },
      "border": { "$value": "rgba(19,17,38,0.08)" },
      "glass-border": { "$value": "rgba(19,17,38,0.08)" },
      "sheen": { "$value": "rgba(255,255,255,0.5)" },
      "ink": { "$value": "{color.brand.ink}", "$description": "Designer: text." },
      "muted": { "$value": "#4C4A66", "$description": "Designer: text-muted." },
      "muted2": { "$value": "#8B89A6", "$description": "Designer: text-muted-2 (labels, overlines)." },
      "muted3": { "$value": "#8B89A6", "$description": "Designer: text-muted-3. Placeholder and decoration only (3.07:1)." },
      "indigo": { "$value": "{color.brand.indigo}", "$description": "Designer: primary." },
      "indigo-bright": { "$value": "{color.brand.indigo}" },
      "indigo-on": { "$value": "#fff", "$description": "Designer: primary-foreground." },
      "indigo-text": { "$value": "{color.brand.indigo}", "$description": "Designer: primary-text, link." },
      "indigo-tint": { "$value": "#EEEDFB", "$description": "Designer: primary-tint." },
      "focus-ring": { "$value": "{color.brand.indigo}", "$description": "PROPOSED." },
      "red": { "$value": "#E5484D", "$description": "Designer: danger. Fills and icons only." },
      "red-text": { "$value": "#C42A2F", "$description": "Designer: danger-text." },
      "red-tint": { "$value": "#FCEBEC" },
      "amber": { "$value": "#B47700", "$description": "Designer: warning. Borders and icons only." },
      "amber-text": { "$value": "#8A5B00", "$description": "Designer: warning-text." },
      "amber-tint": { "$value": "#FBF2DE" },
      "info": { "$value": "{color.brand.indigo}", "$description": "PROPOSED." },
      "info-tint": { "$value": "#EEEDFB", "$description": "PROPOSED." },
      "positive": { "$value": "{color.brand.positive}", "$description": "Incoming-money amounts. Not a status colour." },
      "ink-panel": { "$value": "{color.brand.ink}" },
      "ink-panel-text": { "$value": "#C4C2DC" },
      "input-bg": { "$value": "#FFFFFF" },
      "input-border": { "$value": "rgba(19,17,38,0.11)" },
      "modal-bg": { "$value": "#FFFFFF" },
      "overlay-bg": { "$value": "rgba(19,17,38,0.58)", "$description": "Designer: overlay." },
      "overlay-doc-bg": { "$value": "rgba(19,17,38,0.62)", "$description": "Behind invoice/receipt documents." },
      "panel": { "$value": "#FFFFFF" },
      "success": { "$value": "#1A8A4A" },
      "success-tint": { "$value": "rgba(26,138,74,0.12)" }
    },
    "dark": {
      "$type": "color",
      "bg": { "$value": "#000000" },
      "surface": { "$value": "rgba(255,255,255,0.045)" },
      "surface2": { "$value": "rgba(255,255,255,0.055)" },
      "surface3": { "$value": "rgba(255,255,255,0.11)" },
      "border": { "$value": "rgba(255,255,255,0.1)" },
      "glass-border": { "$value": "rgba(255,255,255,0.1)" },
      "sheen": { "$value": "rgba(255,255,255,0.16)" },
      "ink": { "$value": "#F2F0FA" },
      "muted": { "$value": "#B4B1D0" },
      "muted2": { "$value": "#807D9E" },
      "muted3": { "$value": "#807D9E" },
      "indigo": { "$value": "{color.brand.indigo-lift}" },
      "indigo-bright": { "$value": "{color.brand.indigo-lift}" },
      "indigo-on": { "$value": "#0E0D1C", "$description": "Dark text on lift indigo (5.10:1)." },
      "indigo-text": { "$value": "#A79EFF" },
      "indigo-tint": { "$value": "#221E4A" },
      "focus-ring": { "$value": "#A79EFF", "$description": "PROPOSED." },
      "red": { "$value": "#FF6B70" },
      "red-text": { "$value": "#FF8F93" },
      "red-tint": { "$value": "#3A1B22" },
      "amber": { "$value": "#F5B84B" },
      "amber-text": { "$value": "#F7C76B" },
      "amber-tint": { "$value": "#332A14" },
      "info": { "$value": "#A79EFF", "$description": "PROPOSED." },
      "info-tint": { "$value": "#221E4A", "$description": "PROPOSED." },
      "positive": { "$value": "{color.brand.mint}", "$description": "PROPOSED." },
      "ink-panel": { "$value": "#0B0A14" },
      "ink-panel-text": { "$value": "#C4C2DC" },
      "input-bg": { "$value": "#1C1B24" },
      "input-border": { "$value": "rgba(255,255,255,0.14)" },
      "modal-bg": { "$value": "#121116" },
      "overlay-bg": { "$value": "rgba(0,0,0,0.74)" },
      "panel": { "$value": "#121116" },
      "success": { "$value": "#4ADE80" },
      "success-tint": { "$value": "rgba(74,222,128,0.16)" }
    },
    "dark-high-contrast": {
      "$type": "color",
      "$description": "Overrides layered on top of `dark` when the boosted-contrast setting is on.",
      "surface2": { "$value": "rgba(255,255,255,0.09)" },
      "surface3": { "$value": "rgba(255,255,255,0.16)" },
      "border": { "$value": "rgba(255,255,255,0.18)" },
      "glass-border": { "$value": "rgba(255,255,255,0.18)" },
      "muted2": { "$value": "#9E9BC0" },
      "input-bg": { "$value": "#232029" },
      "input-border": { "$value": "rgba(255,255,255,0.28)" },
      "modal-bg": { "$value": "#17161d" },
      "panel": { "$value": "#17161d" }
    },
    "landing-light": {
      "$type": "color",
      "$description": "Marketing landing page only (approved landing handoff). Kept separate so landing tweaks never drift the dashboard.",
      "landing-bg": { "$value": "{color.brand.bone}" },
      "bg": { "$value": "{color.brand.bone}" },
      "surface": { "$value": "rgba(255,255,255,0.55)" },
      "surface2": { "$value": "rgba(19,17,38,0.045)" },
      "border": { "$value": "rgba(19,17,38,0.08)" },
      "glass-border": { "$value": "rgba(19,17,38,0.08)" },
      "ink": { "$value": "{color.brand.ink}" },
      "muted": { "$value": "#4C4A66" },
      "muted2": { "$value": "#6E6C8A" },
      "muted3": { "$value": "#8B89A6" },
      "indigo": { "$value": "{color.brand.indigo}" },
      "indigo-on": { "$value": "#fff" },
      "indigo-text": { "$value": "{color.brand.indigo}" },
      "indigo-tint": { "$value": "#EEEDFB" },
      "panel": { "$value": "#FFFFFF" }
    },
    "landing-dark": {
      "$type": "color",
      "landing-bg": { "$value": "rgba(255,255,255,0.045)" },
      "bg": { "$value": "#000" },
      "surface": { "$value": "rgba(255,255,255,0.045)" },
      "surface2": { "$value": "rgba(255,255,255,0.055)" },
      "border": { "$value": "rgba(255,255,255,0.1)" },
      "glass-border": { "$value": "rgba(255,255,255,0.1)" },
      "ink": { "$value": "#F2F0FA" },
      "muted": { "$value": "#B4B1D0" },
      "muted2": { "$value": "#8E8BAB" },
      "muted3": { "$value": "#807D9E" },
      "indigo": { "$value": "{color.brand.indigo-lift}" },
      "indigo-on": { "$value": "#0E0D1C" },
      "indigo-text": { "$value": "#A79EFF" },
      "indigo-tint": { "$value": "#221E4A" },
      "panel": { "$value": "#121116" }
    }
  },

  "tailwind": {
    "$description": "Tailwind v4 colour utilities → theme CSS variables. Tailwind's default palette is removed, so ONLY these names exist (bg-primary, text-muted-foreground, border-border…). Names follow shadcn/ui conventions so components added via the shadcn CLI/MCP render on-brand with no edits.",
    "color": {
      "background": "bg",
      "foreground": "ink",
      "card": "panel",
      "card-foreground": "ink",
      "popover": "modal-bg",
      "popover-foreground": "ink",
      "primary": "indigo",
      "primary-foreground": "indigo-on",
      "secondary": "surface2",
      "secondary-foreground": "ink",
      "muted": "surface2",
      "muted-foreground": "muted",
      "subtle-foreground": "muted2",
      "placeholder": "muted3",
      "accent": "indigo-tint",
      "accent-foreground": "indigo-text",
      "link": "indigo-text",
      "destructive": "red",
      "destructive-text": "red-text",
      "destructive-tint": "red-tint",
      "warning": "amber",
      "warning-text": "amber-text",
      "warning-tint": "amber-tint",
      "success": "success",
      "success-tint": "success-tint",
      "info": "info",
      "info-tint": "info-tint",
      "positive": "positive",
      "border": "border",
      "input": "input-border",
      "input-background": "input-bg",
      "ring": "focus-ring",
      "overlay": "overlay-bg",
      "overlay-doc": "overlay-doc-bg",
      "surface-3": "surface3",
      "ink-panel": "ink-panel",
      "ink-panel-foreground": "ink-panel-text"
    }
  }
}
