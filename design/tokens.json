{
  "$description": "Mboka brand + UI design tokens — the ONE source of truth. Structure follows the W3C Design Tokens (DTCG 2025.10) format ($type / $value / $description, {alias} references); colour values are CSS strings for readability. Edit this file, then run `npm run tokens` to regenerate lib/theme/tokens.generated.ts and app/tokens.generated.css. Never edit the generated files.",

  "color": {
    "$type": "color",
    "brand": {
      "$description": "Fixed brand palette (theme-independent). Use for marks, illustrations and marketing accents — not for UI surfaces/text, which use theme tokens.",
      "indigo": { "$value": "#3B2ED3", "$description": "Primary brand colour. CTAs, links, focus ring (light theme)." },
      "indigo-lift": { "$value": "#7C6FFF", "$description": "Indigo lifted for dark backgrounds — dark theme only." },
      "ink": { "$value": "#131126", "$description": "Brand ink. Primary text on light; dark panels." },
      "bone": { "$value": "#F6F4EF", "$description": "Canvas. The app background is bone, never pure white." },
      "amber": { "$value": "#FFB224" },
      "violet": { "$value": "#7C6FFF" },
      "mint": { "$value": "#5ED6B4" },
      "coral": { "$value": "#FF6A55" },
      "positive": { "$value": "#0E7A5A" },
      "positive-on-dark": { "$value": "#0E9A70" }
    },
    "feedback": {
      "$description": "Fixed light-canvas feedback colours used by auth pages (outside the theme toggle).",
      "muted-soft": { "$value": "#6B6980", "$description": "Soft secondary text, ≥4.5:1 on bone." },
      "error-text": { "$value": "#C81E24" },
      "error-field-bg": { "$value": "#FFF8F8" },
      "error-field-border": { "$value": "rgba(229,72,77,0.55)" },
      "error-banner-border": { "$value": "rgba(229,72,77,0.18)" },
      "success-bg": { "$value": "#E8F7EE" },
      "success-text": { "$value": "#1B7A3D" },
      "success-border": { "$value": "rgba(27,122,61,0.16)" }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": "'Space Grotesk', system-ui, sans-serif", "$description": "Headings, navigation chrome, buttons." },
      "body": { "$value": "'DM Sans', system-ui, sans-serif", "$description": "Body copy and form text." },
      "mono": { "$value": "'DM Mono', ui-monospace, monospace", "$description": "Balances, amounts, account numbers, hashes." }
    },
    "size": {
      "$type": "dimension",
      "$description": "Type scale. New code must pick a step — no ad-hoc sizes (legacy code has 15+).",
      "2xs": { "$value": "11px", "$description": "Overlines, uppercase labels." },
      "xs": { "$value": "12.5px", "$description": "Meta text, table secondary, link buttons." },
      "sm": { "$value": "14px", "$description": "Default UI text, inputs, buttons." },
      "base": { "$value": "15px", "$description": "Body copy." },
      "lg": { "$value": "17px", "$description": "Card titles." },
      "xl": { "$value": "20px", "$description": "Section / modal titles." },
      "2xl": { "$value": "24px", "$description": "Page titles." },
      "3xl": { "$value": "32px", "$description": "Hero balances." }
    }
  },

  "radius": {
    "$type": "dimension",
    "sm": { "$value": "8px", "$description": "Chips, small badges." },
    "md": { "$value": "12px", "$description": "Inputs, buttons." },
    "lg": { "$value": "16px", "$description": "Inner cards, list groups." },
    "xl": { "$value": "22px", "$description": "Panels (.ep-panel)." },
    "2xl": { "$value": "28px", "$description": "Modals and sheets." },
    "full": { "$value": "999px", "$description": "Pills, avatars." }
  },

  "shadow": {
    "$type": "shadow",
    "card": { "$value": "0 12px 40px rgba(19,17,38,0.06)" },
    "overlay": { "$value": "0 24px 64px rgba(19,17,38,0.18)" }
  },

  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" },
    "base": { "$value": "200ms" }
  },

  "theme": {
    "$description": "Semantic UI colours per theme. Keys become CSS variables (`bg` → `--bg`). Legacy CSS (.ep-*) and inline styles read these vars; DashboardApp/Landing apply the active set onto <html> via lib/theme/applyThemeVars.",
    "light": {
      "$type": "color",
      "bg": { "$value": "{color.brand.bone}" },
      "surface": { "$value": "rgba(255,255,255,0.55)" },
      "surface2": { "$value": "rgba(19,17,38,0.045)" },
      "surface3": { "$value": "rgba(19,17,38,0.09)" },
      "border": { "$value": "rgba(19,17,38,0.08)" },
      "glass-border": { "$value": "rgba(19,17,38,0.08)" },
      "sheen": { "$value": "rgba(255,255,255,0.5)" },
      "ink": { "$value": "{color.brand.ink}" },
      "muted": { "$value": "#4C4A66" },
      "muted2": { "$value": "#8B89A6" },
      "muted3": { "$value": "#8B89A6" },
      "indigo": { "$value": "{color.brand.indigo}" },
      "indigo-bright": { "$value": "{color.brand.indigo}" },
      "indigo-on": { "$value": "#fff" },
      "indigo-text": { "$value": "{color.brand.indigo}" },
      "indigo-tint": { "$value": "#EEEDFB" },
      "red": { "$value": "#E5484D" },
      "red-tint": { "$value": "#FCEBEC" },
      "amber": { "$value": "#B47700" },
      "amber-tint": { "$value": "#FBF2DE" },
      "ink-panel": { "$value": "{color.brand.ink}" },
      "ink-panel-text": { "$value": "#C4C2DC" },
      "input-bg": { "$value": "#FFFFFF" },
      "input-border": { "$value": "rgba(19,17,38,0.11)" },
      "modal-bg": { "$value": "#FFFFFF" },
      "overlay-bg": { "$value": "rgba(19,17,38,0.58)" },
      "panel": { "$value": "#FFFFFF" },
      "success": { "$value": "#1A8A4A" },
      "success-tint": { "$value": "rgba(26,138,74,0.12)" }
    },
    "dark": {
      "$type": "color",
      "bg": { "$value": "#000000" },
      "surface": { "$value": "rgba(255,255,255,0.045)" },
      "surface2": { "$value": "rgba(255,255,255,0.055)" },
      "surface3": { "$value": "rgba(255,255,255,0.11)" },
      "border": { "$value": "rgba(255,255,255,0.1)" },
      "glass-border": { "$value": "rgba(255,255,255,0.1)" },
      "sheen": { "$value": "rgba(255,255,255,0.16)" },
      "ink": { "$value": "#F2F0FA" },
      "muted": { "$value": "#B4B1D0" },
      "muted2": { "$value": "#807D9E" },
      "muted3": { "$value": "#807D9E" },
      "indigo": { "$value": "{color.brand.indigo-lift}" },
      "indigo-bright": { "$value": "{color.brand.indigo-lift}" },
      "indigo-on": { "$value": "#0E0D1C" },
      "indigo-text": { "$value": "#A79EFF" },
      "indigo-tint": { "$value": "#221E4A" },
      "red": { "$value": "#FF6B70" },
      "red-tint": { "$value": "#3A1B22" },
      "amber": { "$value": "#F5B84B" },
      "amber-tint": { "$value": "#332A14" },
      "ink-panel": { "$value": "#0B0A14" },
      "ink-panel-text": { "$value": "#C4C2DC" },
      "input-bg": { "$value": "#1C1B24" },
      "input-border": { "$value": "rgba(255,255,255,0.14)" },
      "modal-bg": { "$value": "#121116" },
      "overlay-bg": { "$value": "rgba(0,0,0,0.74)" },
      "panel": { "$value": "#121116" },
      "success": { "$value": "#4ADE80" },
      "success-tint": { "$value": "rgba(74,222,128,0.16)" }
    },
    "dark-high-contrast": {
      "$type": "color",
      "$description": "Overrides layered on top of `dark` when the boosted-contrast setting is on.",
      "surface2": { "$value": "rgba(255,255,255,0.09)" },
      "surface3": { "$value": "rgba(255,255,255,0.16)" },
      "border": { "$value": "rgba(255,255,255,0.18)" },
      "glass-border": { "$value": "rgba(255,255,255,0.18)" },
      "muted2": { "$value": "#9E9BC0" },
      "input-bg": { "$value": "#232029" },
      "input-border": { "$value": "rgba(255,255,255,0.28)" },
      "modal-bg": { "$value": "#17161d" },
      "panel": { "$value": "#17161d" }
    },
    "landing-light": {
      "$type": "color",
      "$description": "Marketing landing page only (approved landing handoff). Kept separate so landing tweaks never drift the dashboard.",
      "landing-bg": { "$value": "{color.brand.bone}" },
      "bg": { "$value": "{color.brand.bone}" },
      "surface": { "$value": "rgba(255,255,255,0.55)" },
      "surface2": { "$value": "rgba(19,17,38,0.045)" },
      "border": { "$value": "rgba(19,17,38,0.08)" },
      "glass-border": { "$value": "rgba(19,17,38,0.08)" },
      "ink": { "$value": "{color.brand.ink}" },
      "muted": { "$value": "#4C4A66" },
      "muted2": { "$value": "#6E6C8A" },
      "muted3": { "$value": "#8B89A6" },
      "indigo": { "$value": "{color.brand.indigo}" },
      "indigo-on": { "$value": "#fff" },
      "indigo-text": { "$value": "{color.brand.indigo}" },
      "indigo-tint": { "$value": "#EEEDFB" },
      "panel": { "$value": "#FFFFFF" }
    },
    "landing-dark": {
      "$type": "color",
      "landing-bg": { "$value": "rgba(255,255,255,0.045)" },
      "bg": { "$value": "#000" },
      "surface": { "$value": "rgba(255,255,255,0.045)" },
      "surface2": { "$value": "rgba(255,255,255,0.055)" },
      "border": { "$value": "rgba(255,255,255,0.1)" },
      "glass-border": { "$value": "rgba(255,255,255,0.1)" },
      "ink": { "$value": "#F2F0FA" },
      "muted": { "$value": "#B4B1D0" },
      "muted2": { "$value": "#8E8BAB" },
      "muted3": { "$value": "#807D9E" },
      "indigo": { "$value": "{color.brand.indigo-lift}" },
      "indigo-on": { "$value": "#0E0D1C" },
      "indigo-text": { "$value": "#A79EFF" },
      "indigo-tint": { "$value": "#221E4A" },
      "panel": { "$value": "#121116" }
    }
  },

  "tailwind": {
    "$description": "Tailwind v4 colour utilities → theme CSS variables. Tailwind's default palette is removed, so ONLY these names exist (bg-primary, text-muted-foreground, border-border…). Names follow shadcn/ui conventions so components added via the shadcn CLI/MCP render on-brand with no edits.",
    "color": {
      "background": "bg",
      "foreground": "ink",
      "card": "panel",
      "card-foreground": "ink",
      "popover": "modal-bg",
      "popover-foreground": "ink",
      "primary": "indigo",
      "primary-foreground": "indigo-on",
      "secondary": "surface2",
      "secondary-foreground": "ink",
      "muted": "surface2",
      "muted-foreground": "muted",
      "subtle-foreground": "muted2",
      "accent": "indigo-tint",
      "accent-foreground": "indigo-text",
      "link": "indigo-text",
      "destructive": "red",
      "destructive-tint": "red-tint",
      "warning": "amber",
      "warning-tint": "amber-tint",
      "success": "success",
      "success-tint": "success-tint",
      "border": "border",
      "input": "input-border",
      "input-background": "input-bg",
      "ring": "indigo",
      "overlay": "overlay-bg",
      "surface-3": "surface3",
      "ink-panel": "ink-panel",
      "ink-panel-foreground": "ink-panel-text"
    }
  }
}
